{
  "name": "forge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.2.22",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --cwd packages/client dev",
    "build": "bun run --cwd packages/client build",
    "typecheck": "bun run --cwd packages/client typecheck",
    "rebuild": "bun run --cwd packages/client rebuild",
    "test": "bun test"
  }
}
