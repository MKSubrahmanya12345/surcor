{
  "name": "forge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.2.22",
  "workspaces": ["packages/*"],
  "devDependencies": {
    "opencascade-tools": "^0.0.9"
  },
  "scripts": {
    "dev": "bun run --cwd packages/client dev",
    "build:server": "bun build packages/server/src/server.ts --target bun --outdir packages/server/dist",
    "build": "bun run build:server && bun run --cwd packages/client build && bun run --cwd packages/client dist",
    "typecheck": "bun run --cwd packages/client typecheck",
    "rebuild": "bun run --cwd packages/client rebuild",
    "test": "bun test"
  }
}
