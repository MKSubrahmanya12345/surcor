# ---------------------------------------------------------------------------
# Forge desktop client — packages/client/.env
# Copy to `.env` in this directory. Everything here is optional.
# ---------------------------------------------------------------------------

# --- Agent server connection (read by the renderer, so VITE_ is required) ----
# Where services/agentSocket.ts opens its WebSocket.
#VITE_FORGE_AGENT_URL=ws://localhost:4500
# Must match the server's FORGE_SERVER_TOKEN when one is set.
#VITE_FORGE_AGENT_TOKEN=

# --- GitHub device flow (read by the Electron main process) ------------------
# Client ID of a GitHub OAuth App: https://github.com/settings/developers
# (no client secret — device flow does not use one; the callback URL is unused
# but GitHub requires one, so enter http://localhost).
# The GitHub panel also accepts a pasted Client ID when this is unset.
#FORGE_GITHUB_CLIENT_ID=Iv1.yourclientid

# --- Vite/Electron plumbing --------------------------------------------------
# Set automatically by vite-plugin-electron; only define it to load a packaged
# renderer from a dev server you started yourself.
#VITE_DEV_SERVER_URL=http://localhost:5173
