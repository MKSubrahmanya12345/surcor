# ---------------------------------------------------------------------------
# Forge agent server — packages/server/.env
# Copy to `.env` in this directory. Every value below is optional: the defaults
# in src/config.ts are shown next to each key.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Loopback only by default. Anything else REQUIRES FORGE_SERVER_TOKEN.
HOST=127.0.0.1
PORT=4500
# Shared secret for the WebSocket/HTTP endpoint. Required when HOST is not
# loopback. The Electron renderer can pass it as VITE_FORGE_AGENT_TOKEN.
#FORGE_SERVER_TOKEN=
# Extra browser origins allowed to connect without a token (comma separated).
#ALLOWED_ORIGINS=http://localhost:5173
# SQLite file for chat history, diffs and the codebase index.
# Defaults to ~/.forge/forge.sqlite. Relative paths resolve against
# packages/server (no "~" expansion), so prefer an absolute path.
#DATABASE_PATH=/absolute/path/to/forge.sqlite
#DATABASE_PATH=:memory:

# --- Chat providers ---------------------------------------------------------
# Tried in this order; the first one that is configured AND answers wins, and
# any failure/rate-limit falls through to the next. Remove providers you do not
# use — an unconfigured provider is skipped, not an error.
PROVIDER_ORDER=anthropic,openai,gemini,ollama,bedrock

ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=https://api.anthropic.com
#ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o

# GEMINI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY=
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#GEMINI_MODEL=gemini-2.5-flash

# Local, no key. Only used when Ollama is actually running on this port.
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_MODEL=llama3.1:8b

# --- Amazon Bedrock (Converse API) ------------------------------------------
# No API key: Bedrock authenticates with AWS credentials (SigV4) or a Bedrock
# bearer token. It is skipped unless one of these resolves.
#
#   Option A — Bedrock API key / IAM Identity Center bearer token (simplest):
#AWS_BEARER_TOKEN_BEDROCK=
#
#   Option B — static IAM keys (optionally with a session token):
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
#
#   Option C — nothing here at all: the server reads your shared AWS config
#   (~/.aws/credentials, ~/.aws/config), including `credential_process` used by
#   `aws sso login`. Pick the profile with AWS_PROFILE (default: "default").
#AWS_PROFILE=default
#
# Model id, inference-profile id or inference-profile ARN. Use a profile id
# (the "us." / "eu." / "apac." prefix) — on-demand throughput rejects base ids.
#BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#BEDROCK_MODEL=amazon.nova-pro-v1:0
#BEDROCK_MODEL=arn:aws:bedrock:us-east-1:123456789012:inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Region also decides the endpoint host when BEDROCK_BASE_URL is unset.
# Falls back to AWS_REGION / AWS_DEFAULT_REGION, then us-east-1.
#BEDROCK_REGION=us-east-1
#BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com
# false => non-streaming POST /model/{id}/converse (whole reply at once).
#BEDROCK_STREAMING=true

# A Bedrock-only setup:
#PROVIDER_ORDER=bedrock,ollama

# --- Agent limits -----------------------------------------------------------
#PROVIDER_TIMEOUT_MS=120000
#AGENT_MAX_TURNS=12
#AGENT_MAX_TOOL_CALLS=8
#MAX_OUTPUT_TOKENS=4096
#COMMAND_TIMEOUT_MS=120000
#MAX_FILE_BYTES=1048576
#MAX_OUTPUT_BYTES=262144

# --- Codebase indexing (Prompt 5) -------------------------------------------
# Builds in the background when a workspace is opened and refreshes before
# every search_codebase call.
#INDEX_ENABLED=true
# Embedding providers, in order. Ollama is local and free; OpenAI is the
# fallback when Ollama is not running.
#EMBEDDING_ORDER=ollama,openai
#OLLAMA_EMBED_MODEL=nomic-embed-text
#OPENAI_EMBED_MODEL=text-embedding-3-small
# Reuses OLLAMA_BASE_URL / OPENAI_BASE_URL / OPENAI_API_KEY from above.
#INDEX_MAX_FILES=20000
#INDEX_MAX_FILE_BYTES=524288
#INDEX_MAX_CHUNK_TOKENS=220
#INDEX_MAX_DEPTH=24
#INDEX_BATCH_SIZE=32
#EMBEDDING_TIMEOUT_MS=30000

# --- Web search tool (Prompt 5) ---------------------------------------------
# Tavily first; Brave is used when TAVILY_API_KEY is unset or Tavily fails.
# Without either key, web_search returns an actionable error.
TAVILY_API_KEY=
#TAVILY_BASE_URL=https://api.tavily.com
# BRAVE_API_KEY or BRAVE_SEARCH_API_KEY
BRAVE_API_KEY=
#BRAVE_BASE_URL=https://api.search.brave.com/res/v1
#WEB_SEARCH_MAX_RESULTS=5
#WEB_SEARCH_TIMEOUT_MS=15000

# --- MCP client (Prompt 6) --------------------------------------------------
# External tool servers from ~/.forge/mcp.json (Cursor / Claude Desktop shape);
# their tools are registered as mcp__<server>__<tool>. Editable without
# hand-writing JSON via the Settings panel (gear icon) in the app.
#MCP_ENABLED=true
#MCP_CONFIG_PATH=/custom/path/mcp.json
#MCP_REQUEST_TIMEOUT_MS=30000

# --- CAD mode (Prompt 7) ----------------------------------------------------
# Text-to-model. Forge connects to a MAC (Multi-Agent CAD) sidecar that YOU
# install and start once — see sidecars/README.md. Nothing here is required for
# the other modes, and nothing here makes Forge install the sidecar.
#FORGE_CAD_ENABLED=true
#FORGE_CAD_MAC_URL=http://127.0.0.1:8000
#
# Which LLM the four MAC stages call. With these unset, Forge reuses the first
# OpenAI-compatible provider in PROVIDER_ORDER (openai, gemini, or ollama) —
# including its key — and the sidecar's own config.py stays untouched, because
# Forge sends a full per-job config the sidecar applies via MAC_CONFIG_FILE.
#FORGE_CAD_BASE_URL=http://localhost:11434/v1
#FORGE_CAD_MODEL=qwen3-coder:32b
#FORGE_CAD_API_KEY=
#FORGE_CAD_PROVIDER=ollama
#
# Total QA attempts. Sent to MAC as MAX_RETRIES so the retries happen inside
# MAC's own autonomous loop (its 10s iteration checkpoint auto-iterates) instead
# of restarting the pipeline. When the budget is exhausted, CAD mode fails with
# the diagnostics quoted — it never keeps the "best" failed attempt.
#FORGE_CAD_ATTEMPT_BUDGET=3
#FORGE_CAD_JOB_TIMEOUT_MS=900000
#
# Search-first path: look for a real manufacturer/standard STEP file before
# generating one (strictly better for e.g. "arduino uno"). Needs the Prompt 5
# web-search key above; a .step URL that turns out to be a login page or a
# truncated body is rejected, and so is anything OpenCASCADE cannot read.
#FORGE_CAD_SEARCH=true
#FORGE_CAD_SEARCH_MAX_RESULTS=8
#FORGE_CAD_MAX_DOWNLOAD_BYTES=67108864
#
# STEP → GLB for the in-app viewer (also the parse check for downloaded files).
#FORGE_CAD_OCCT_BIN=opencascade-tools      # npm install -g opencascade-tools
#FORGE_CAD_OCCT_TIMEOUT_MS=180000
#FORGE_CAD_OCCT_LIN_DEFLECTION=0.25
#FORGE_CAD_OCCT_ANG_DEFLECTION=0.35
#
# Where verified models are cached and served from (GET /cad/artifact?path=…).
#FORGE_CAD_ARTIFACT_DIR=~/.forge/cad
# Safety net: refuse a bare box/cylinder/sphere for a request that asked for
# features. It only ever rejects; it never approves a model on its own.
#FORGE_CAD_TRIVIAL_PRIMITIVE_GUARD=true
